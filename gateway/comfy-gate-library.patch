+    async def install_library(self, ids: list[str]) -> str:
+        """Install library entries (custom nodes / models) onto the running VM. Returns '' or a refusal."""
+        m = self.machine
+        if m.state != State.READY or not m.profile:
+            return "not_ready"
+        if self._fetch_task and not self._fetch_task.done():
+            return "fetch_in_progress"
+        lib = {i["id"]: i for i in library.load(self.settings.state_dir)}
+        items = [lib[i] for i in ids if i in lib]
+        if not items or len(items) != len(set(ids)):
+            return "unknown_item"
+        plan = library.fetch_plan(build_plan(self.profiles[m.profile], self.settings), items)
+        self.fetching, self.fetch_error = ["lib:" + i["id"] for i in items], ""
+        self.bus.publish("state", self.status())
+        self._fetch_task = asyncio.create_task(self._fetch(plan))
+        return ""
+
     async def _fetch(self, plan: dict) -> None:
         name = self.settings.colab_session_name
         fd = tempfile.NamedTemporaryFile("w", suffix=".json", delete=False)
@@ -498,6 +517,7 @@ class Session:
         self.progress = {}
