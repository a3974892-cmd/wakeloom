+async def library_list(request: web.Request) -> web.Response:
+    """GET /_gate/library: saved on-demand nodes/models + what is on the current VM."""
+    s = request.app[SESSION]
+    return web.json_response({"items": library.load(request.app[SETTINGS].state_dir),
+                              "installed": list(s.lib_installed), "fetching": list(s.fetching),
+                              "fetch_error": s.fetch_error})
+
+
+async def library_add(request: web.Request) -> web.Response:
+    """POST /_gate/library {kind, url, title?, dest? (models), ref?, subdir?, auto_wake?}: add or update."""
+    ident = _ident(request)
+    try:
+        authorize(ident, "wake", request.app[SETTINGS])
+    except AuthError as e:
+        return err(e.status, e.code, e.msg)
+    body = await _body(request)
+    try:
+        item = library.normalize(body)
+    except library.LibraryError as e:
+        return err(400, "bad_request", str(e))
+    if item["kind"] == "model" and "size_gb" not in item:
+        size = await asyncio.get_running_loop().run_in_executor(None, library.probe_size_gb, item["url"])
+        if size:
+            item["size_gb"] = size
+    sd = request.app[SETTINGS].state_dir
+    library.save(sd, library.upsert(library.load(sd), item))
+    return web.json_response(item)
+
+
+async def library_delete(request: web.Request) -> web.Response:
+    ident = _ident(request)
+    try:
+        authorize(ident, "wake", request.app[SETTINGS])
+    except AuthError as e:
+        return err(e.status, e.code, e.msg)
+    sd = request.app[SETTINGS].state_dir
+    iid = request.match_info["id"]
+    items = library.load(sd)
+    if not any(i["id"] == iid for i in items):
+        return err(404, "unknown_item", "no such library item")
+    library.save(sd, [i for i in items if i["id"] != iid])
+    return web.json_response({"deleted": iid})
+
+
+async def library_install(request: web.Request) -> web.Response:
+    """POST /_gate/library/install {"ids": [...]}: install onto the running VM (nodes trigger a ComfyUI restart)."""
+    ident = _ident(request)
+    try:
+        authorize(ident, "wake", request.app[SETTINGS])
+    except AuthError as e:
+        return err(e.status, e.code, e.msg)
+    body = await _body(request)
+    ids = body.get("ids")
+    if not isinstance(ids, list) or not ids or not all(isinstance(i, str) for i in ids):
+        return err(400, "bad_request", "body must be {\"ids\": [\"<id>\", ...]}")
+    why = await request.app[SESSION].install_library(ids)
+    if why:
+        return err(404 if why == "unknown_item" else 409, why, f"install refused: {why}")
+    return web.json_response({"installing": ids}, status=202)
+
