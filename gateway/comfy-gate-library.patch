@@ -0,0 +1,89 @@
+import json
+
+import pytest
+
+from gate import library
+
+
+def test_normalize_node_and_model():
+    n = library.normalize({"kind": "node", "url": "https://github.com/numz/ComfyUI-SeedVR2_VideoUpscaler.git"})
+    assert n["id"] == "comfyui-seedvr2_videoupscaler" and n["title"] == "ComfyUI-SeedVR2_VideoUpscaler"
+    m = library.normalize({"kind": "model", "url": "hf://numz/SeedVR2_comfyUI/ema_vae_fp16.safetensors",
+                           "dest": "SEEDVR2/ema_vae_fp16.safetensors", "size_gb": 0.5, "auto_wake": 1})
+    assert m["id"] == "seedvr2-ema_vae_fp16-safetensors" and m["auto_wake"] is True and m["size_gb"] == 0.5
+
+
+@pytest.mark.parametrize("bad", [
+    {"kind": "x", "url": "https://a/b"},
+    {"kind": "node", "url": "http://insecure/x"},
+    {"kind": "node", "url": "https://h/x?token=abc"},
+    {"kind": "model", "url": "https://h/x.bin", "dest": "../etc/passwd"},
+    {"kind": "model", "url": "https://h/x.bin", "dest": "nofolder.bin"},
+])
+def test_normalize_rejects(bad):
+    with pytest.raises(library.LibraryError):
+        library.normalize(bad)
+
+
+def test_store_roundtrip_and_plans(tmp_path):
+    sd = str(tmp_path)
+    node = library.normalize({"kind": "node", "url": "https://github.com/a/node-x"})
+    model = library.normalize({"kind": "model", "url": "hf://o/r/m.safetensors", "dest": "SEEDVR2/m.safetensors",
+                               "auto_wake": True})
+    library.save(sd, library.upsert(library.upsert([], node), model))
+    items = library.load(sd)
+    assert {i["id"] for i in items} == {node["id"], model["id"]}
+    base = {"profile": "p", "comfyui": {}, "models": [{"id": "core", "dest": "a/b", "core": True}],
+            "custom_nodes": [], "workflows": [{"id": "w"}], "smoke": {"x": 1}}
+    fp = library.fetch_plan(base, items)
+    assert fp["fetch_only"] and fp["restart_comfy"] and fp["workflows"] == [] and fp["smoke"] is None
+    assert [m["dest"] for m in fp["models"]] == ["SEEDVR2/m.safetensors"]
+    assert fp["models"][0]["url"].startswith("https://huggingface.co/o/r/resolve/")
+    assert sorted(fp["library_ids"]) == sorted([node["id"], model["id"]])
+    boot = json.loads(json.dumps(base))
+    added = library.merge_into_boot(boot, [i for i in items if i.get("auto_wake")])
+    assert added == [model["id"]] and boot["models"][-1]["core"] is False
+
+
+async def test_library_endpoints_and_install(tmp_path):
+    import asyncio
+
+    from tests.test_app import client
+    from gate.app import SESSION
+    from gate.state import State
+
+    c, app = await client(tmp_path)
+    try:
+        r = await c.post("/_gate/library", json={"kind": "node", "url": "https://github.com/a/node-x"})
+        assert r.status == 200 and (await r.json())["id"] == "node-x"
+        r = await c.post("/_gate/library", json={"kind": "model", "url": "https://h/m.bin", "dest": "x/m.bin",
+                                                 "size_gb": 1, "auto_wake": True})
+        mid = (await r.json())["id"]
+        r = await c.post("/_gate/library", json={"kind": "model", "url": "https://h/m.bin", "dest": "../x"})
+        assert r.status == 400
+        r = await c.get("/_gate/library")
+        assert {i["id"] for i in (await r.json())["items"]} == {"node-x", mid}
+        r = await c.post("/_gate/library/install", json={"ids": ["node-x"]})
+        assert r.status == 409  # asleep
+        # wake: the auto_wake model joins the boot plan and counts as installed
+        await c.post("/_gate/wake", json={"profile": "tiny"})
+        s = app[SESSION]
+        for _ in range(200):
+            if s.machine.state == State.READY:
+                break
+            await asyncio.sleep(0.02)
+        assert s.machine.state == State.READY and s.lib_installed == [mid]
+        s.colab.lines = ['KIT_FETCHED {"workflows": [], "library": ["node-x"]}']
+        r = await c.post("/_gate/library/install", json={"ids": ["node-x"]})
+        assert r.status == 202
+        for _ in range(100):
+            if not s.fetching:
+                break
+            await asyncio.sleep(0.02)
+        assert "node-x" in s.lib_installed
+        r = await c.post("/_gate/library/install", json={"ids": ["nope"]})
+        assert r.status == 404
+        r = await c.delete("/_gate/library/node-x")
+        assert r.status == 200
+    finally:
+        await c.close()
